<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste du paquet MSIX de ZogmaDeck (Microsoft Store), utilisé par build.ps1 -Task msix.
  Identité réservée dans Partner Center (Gestion des produits › Identité du produit) : ne pas modifier Name ni Publisher.
  La version est remplacée à la construction par celle de Directory.Build.props (4e nombre toujours 0 pour le Store).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity Name="TOMAZKI.ZogmaDeck" Publisher="CN=683599A3-0189-4C97-92C8-4F14962DC73A" Version="0.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ZogmaDeck</DisplayName>
    <PublisherDisplayName>TOMAZKI</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Panneau de boutons personnalisables pour lancer des actions en un clic ou un raccourci clavier.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <!-- Application principale : menu Démarrer, affiche le deck au lancement. -->
    <Application Id="ZogmaDeck" Executable="ZogmaDeck.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="ZogmaDeck" Description="Panneau de boutons personnalisables (actions, raccourcis, sons, OBS)."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" ShortName="ZogmaDeck" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>

    <!--
      Point d'entrée masqué utilisé uniquement à l'ouverture de session : même exécutable, lancé avec l'argument « tray »
      (démarrage discret dans la zone de notification). Activé ou désactivé par ZogmaDeck › Réglages, ou par
      l'utilisateur dans Paramètres Windows › Applications › Démarrage.
    -->
    <Application Id="ZogmaDeckTray" Executable="ZogmaDeck.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--tray">
      <uap:VisualElements DisplayName="ZogmaDeck" Description="Démarrage de ZogmaDeck dans la zone de notification."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="ZogmaDeck.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ZogmaDeckStartup" Enabled="false" DisplayName="ZogmaDeck" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Application de bureau Win32 : raccourci clavier global, envoi de touches, lancement de programmes. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
