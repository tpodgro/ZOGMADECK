<UserControl x:Class="ZogmaDeck.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="Toggle" Padding="6,4" HorizontalAlignment="Left" AutomationProperties.Name="Choisir une couleur personnalisée"
                      ToolTip="Choisir n'importe quelle couleur">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Swatch" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Pd.BorderStrong}" />
                <TextBlock Text="Personnaliser…" Margin="8,0,2,0" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" PopupAnimation="Fade">
            <Border Background="{DynamicResource Pd.Surface}" BorderBrush="{DynamicResource Pd.BorderStrong}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,4,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Width="248">
                    <!-- Saturation (horizontal) et luminosité (vertical) pour la teinte choisie -->
                    <Grid x:Name="SvArea" Height="160" Cursor="Cross" Focusable="True" ClipToBounds="True"
                          AutomationProperties.Name="Saturation et luminosité (flèches pour ajuster)"
                          MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="Area_MouseUp" KeyDown="SvArea_KeyDown">
                        <Border x:Name="HueFill" CornerRadius="4" />
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <!-- Teinte -->
                    <Grid x:Name="HueArea" Height="16" Margin="0,10,0,0" Cursor="Hand" Focusable="True" ClipToBounds="False"
                          AutomationProperties.Name="Teinte (flèches pour ajuster)"
                          MouseLeftButtonDown="HueArea_MouseDown" MouseMove="HueArea_MouseMove" MouseLeftButtonUp="Area_MouseUp" KeyDown="HueArea_KeyDown">
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="8" Height="20" Canvas.Top="-2" CornerRadius="3" BorderBrush="White" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>
                    <DockPanel Margin="0,12,0,0">
                        <Border x:Name="Preview" DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Pd.BorderStrong}" Margin="0,0,8,0" />
                        <TextBox x:Name="HexBox" VerticalContentAlignment="Center" AutomationProperties.Name="Code couleur hexadécimal"
                                 TextChanged="HexBox_TextChanged" />
                    </DockPanel>
                    <TextBlock Text="Code #RRGGBB, ou cliquez dans les zones ci-dessus." Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Pd.TextTertiary}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
