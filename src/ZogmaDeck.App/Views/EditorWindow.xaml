<Window x:Class="ZogmaDeck.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZogmaDeck.ViewModels"
        xmlns:ctl="clr-namespace:ZogmaDeck.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:EditorViewModel}"
        Title="ZogmaDeck — Éditeur"
        Width="1220" Height="780" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource Pd.WindowBackground}"
        Foreground="{DynamicResource Pd.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">

    <Window.Resources>
        <!-- Aperçu d'une tuile (non cliquable) -->
        <DataTemplate x:Key="TilePreview" DataType="{x:Type vm:PanelButtonViewModel}">
            <Grid Width="{Binding Size}" Height="{Binding Size}">
                <!-- Fond foncé derrière la tuile en thème clair : le style verre (libellé blanc) est conçu pour le panneau -->
                <Border CornerRadius="{Binding CornerRadius}" Background="{DynamicResource Pd.TileBackdrop}" />
                <Border CornerRadius="{Binding CornerRadius}" Background="{Binding TileBackground}" BorderBrush="{Binding TileBorder}" BorderThickness="1" />
                <Border CornerRadius="{Binding CornerRadius}" Background="{Binding Sheen}" />
                <Grid Margin="6" TextElement.Foreground="{Binding LabelForeground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="{Binding BadgeSize}" Height="{Binding BadgeSize}" CornerRadius="{Binding BadgeCorner}" Background="{Binding BadgeBrush}"
                            Effect="{Binding BadgeEffect}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <TextBlock Style="{StaticResource Pd.Glyph}" Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="{Binding GlyphSize}" FontWeight="{Binding GlyphWeight}"
                                       Foreground="{Binding IconForeground}" Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}" />
                            <Path Data="{Binding Geometry}" Fill="{Binding IconForeground}" Stretch="Uniform" Width="{Binding GeometrySize}" Height="{Binding GeometrySize}"
                                  Visibility="{Binding HasGeometry, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <Image Source="{Binding Image}" Width="{Binding ImageSize}" Height="{Binding ImageSize}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="{Binding LabelSize}" TextAlignment="Center" Effect="{Binding LabelEffect}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="{Binding LabelMaxHeight}" Margin="0,3,0,0"
                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ===== Champs d'action générés ===== -->
        <DataTemplate DataType="{x:Type vm:TextFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dossier…" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding BrowseFolderCommand}"
                            Visibility="{Binding CanBrowseFolder, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right" Content="Parcourir…" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding BrowseFileCommand}"
                            Visibility="{Binding CanBrowseFile, Converter={StaticResource BoolToVis}}" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                             AcceptsReturn="{Binding IsMultiline}" MinLines="{Binding MinLines}" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalContentAlignment" Value="Top" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                                        <Setter Property="FontFamily" Value="{StaticResource Pd.MonoFont}" />
                                        <Setter Property="FontSize" Value="13" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Placeholder, StringFormat='Exemple : {0}', TargetNullValue=''}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
                <TextBlock Style="{StaticResource Pd.WarningAuto}" Text="{Binding Warning}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToggleFieldViewModel}">
            <CheckBox Margin="0,0,0,12" Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IntegerFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="140" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Pd.TextSecondary}" />
                    <TextBlock Text="{Binding Human}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Pd.TextTertiary}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding Error}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SliderFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding ValueText}" />
                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding SliderValue}" IsSnapToTickEnabled="True"
                            TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChoiceFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KeyChordFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Effacer" Margin="6,0,0,0" Command="{Binding ClearCommand}" />
                    <ctl:KeyChordBox Chord="{Binding Keys}" AutomationProperties.Name="{Binding Label}" />
                </DockPanel>
                <TextBlock Text="Ou touche spéciale (multimédia, F13–F24) :" Style="{StaticResource Pd.Label}" Margin="0,10,0,4" />
                <ComboBox ItemsSource="{Binding SpecialKeys}" SelectedItem="{Binding SelectedSpecial}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Touche spéciale" />
                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding Error}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                          AutomationProperties.Name="{Binding Label}" />
                <TextBlock Style="{StaticResource Pd.WarningAuto}" Text="{Binding Warning}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ObsListFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Récupérer la liste depuis OBS">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Liste OBS" />
                        </StackPanel>
                    </Button>
                    <ComboBox IsEditable="True" ItemsSource="{Binding Items}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{Binding Label}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Status}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SoundFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Parcourir…" Margin="6,0,0,0" Command="{Binding BrowseFileCommand}" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label}" />
                </DockPanel>
                <TextBlock Text="Ou un son de la bibliothèque intégrée :" Style="{StaticResource Pd.Label}" Margin="0,10,0,4" />
                <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedLibrarySound}" DisplayMemberPath="Display"
                          MaxDropDownHeight="360" AutomationProperties.Name="Bibliothèque de sons" />
                <TextBlock Text="Extrait à jouer" Style="{StaticResource Pd.Label}" Margin="0,12,0,0" />
                <ctl:RangeSlider Minimum="0" Maximum="{Binding Duration}" SmallChange="{Binding Step}" IsEnabled="{Binding HasDuration}"
                                 LowerValue="{Binding RangeStart, Mode=TwoWay}" UpperValue="{Binding RangeEnd, Mode=TwoWay}"
                                 RangeCommitted="SoundRange_Committed" AutomationProperties.Name="Extrait à jouer" />
                <TextBlock Text="{Binding SegmentText}" Foreground="{DynamicResource Pd.TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Command="{Binding PreviewCommand}" Margin="0,0,6,4" ToolTip="Écouter l'extrait choisi avec le volume réglé" AutomationProperties.Name="Écouter l'extrait">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE768;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Écouter l'extrait" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,6,4" Command="{Binding StopCommand}" ToolTip="Arrêter l'écoute" AutomationProperties.Name="Arrêter l'écoute">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE71A;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Arrêter" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,12,4" Content="Fichier entier" Command="{Binding ResetSegmentCommand}" ToolTip="Jouer le fichier du début à la fin" />
                    <CheckBox Content="Écouter après chaque réglage" IsChecked="{Binding AutoPreview}" VerticalAlignment="Center" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Pd.WarningAuto}" Text="{Binding Warning}" />
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Sons gratuits en ligne (vérifiez la licence de chaque son) :" Foreground="{DynamicResource Pd.TextTertiary}" FontSize="12" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding OnlineSources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" Margin="0,0,10,0">
                                    <Hyperlink Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Value}"><Run Text="{Binding Label, Mode=OneWay}" /></Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GameFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Rechercher à nouveau les jeux installés">
                        <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE72C;" FontSize="13" />
                    </Button>
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" DisplayMemberPath="Display"
                              MaxDropDownHeight="360" AutomationProperties.Name="Jeux installés" />
                </DockPanel>
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Status}" />
                <TextBlock Text="Identifiant du jeu" Style="{StaticResource Pd.Label}" Margin="0,8,0,4" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Identifiant du jeu" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimeFieldViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Pd.Label}" />
                <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding Error}" />
                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="sel" CornerRadius="11" Margin="-4" BorderThickness="2" BorderBrush="Transparent" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sel" Property="BorderBrush" Value="{DynamicResource Pd.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Pd.Border}" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Pd.TextTertiary}"
                           Text="Les modifications sont enregistrées automatiquement." />
                <TextBlock FontSize="12" Foreground="{DynamicResource Pd.TextSecondary}" Text="{Binding SaveStatus}" />
            </DockPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="12,8,12,0" Padding="0">

            <!-- ================= BOUTONS ================= -->
            <TabItem Header="Boutons">
                <Grid Margin="4,12,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="440" />
                    </Grid.ColumnDefinitions>

                    <!-- Profils -->
                    <Border Style="{StaticResource Pd.Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Profils" Style="{StaticResource Pd.Section}" />
                            <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding SelectedProfile}" Margin="0,8,0,0">
                                <TextBlock Text="Nom du profil" Style="{StaticResource Pd.Label}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom du profil" />
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding NameError}" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,12,0,0" Text="{Binding Columns, StringFormat='Colonnes du deck : {0}'}" />
                                <Slider Minimum="1" Maximum="12" Value="{Binding Columns}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        AutomationProperties.Name="Nombre de colonnes" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,8,0,0" Text="{Binding ButtonSize, StringFormat='Taille des boutons : {0} px'}" />
                                <Slider Minimum="48" Maximum="200" Value="{Binding ButtonSize}" IsSnapToTickEnabled="True" TickFrequency="4"
                                        AutomationProperties.Name="Taille des boutons" />
                                <Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Content="Afficher dans le panneau"
                                        Command="{Binding DataContext.ShowInPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE710;" ToolTip="Nouveau profil" Command="{Binding AddProfileCommand}" AutomationProperties.Name="Nouveau profil" />
                                <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE8C8;" ToolTip="Dupliquer le profil" Command="{Binding DuplicateProfileCommand}" AutomationProperties.Name="Dupliquer le profil" />
                                <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE74D;" ToolTip="Supprimer le profil" Command="{Binding DeleteProfileCommand}" AutomationProperties.Name="Supprimer le profil" />
                                <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE70E;" ToolTip="Monter" Command="{Binding MoveProfileUpCommand}" AutomationProperties.Name="Monter le profil" />
                                <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE70D;" ToolTip="Descendre" Command="{Binding MoveProfileDownCommand}" AutomationProperties.Name="Descendre le profil" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                     ctl:DragReorder.MoveCommand="{Binding MoveProfileCommand}" AutomationProperties.Name="Profils" />
                        </DockPanel>
                    </Border>

                    <!-- Grille des boutons du profil -->
                    <Border Grid.Column="2" Style="{StaticResource Pd.Card}" Padding="12" DataContext="{Binding SelectedProfile}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding AddButtonCommand}" Margin="0,0,6,0" ToolTip="Nouveau bouton (Ctrl+N)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Ajouter" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE8C8;" ToolTip="Dupliquer (Ctrl+D)" Command="{Binding DuplicateButtonCommand}" AutomationProperties.Name="Dupliquer le bouton" />
                                    <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE74D;" ToolTip="Supprimer (Suppr)" Command="{Binding DeleteButtonCommand}" AutomationProperties.Name="Supprimer le bouton" />
                                    <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE72B;" ToolTip="Déplacer avant (Alt+←)" Command="{Binding MoveLeftCommand}" AutomationProperties.Name="Déplacer avant" />
                                    <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE72A;" ToolTip="Déplacer après (Alt+→)" Command="{Binding MoveRightCommand}" AutomationProperties.Name="Déplacer après" />
                                </StackPanel>
                                <TextBlock Text="{Binding Name, StringFormat='Boutons — {0}'}" Style="{StaticResource Pd.Section}" VerticalAlignment="Center" Margin="0"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Pd.Hint}"
                                       Text="Glisser-déposer ou Alt+flèches pour réorganiser · Suppr pour supprimer · Ctrl+D pour dupliquer" />
                            <ListBox x:Name="ButtonsList" ItemsSource="{Binding Buttons}" SelectedItem="{Binding SelectedButton}"
                                     ItemContainerStyle="{StaticResource TileItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ctl:DragReorder.MoveCommand="{Binding MoveButtonCommand}" AutomationProperties.Name="Boutons du profil"
                                     KeyDown="ButtonsList_KeyDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Répartition selon la largeur de l'éditeur (indépendante de la disposition du deck) ; l'ordre est le même. -->
                                        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ButtonEditViewModel}">
                                        <Grid AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Summary}">
                                            <ContentPresenter Content="{Binding Preview}" ContentTemplate="{StaticResource TilePreview}" />
                                            <Border Width="18" Height="18" CornerRadius="9" Background="#E6C42B1C" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0" ToolTip="Configuration incomplète"
                                                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Propriétés du bouton sélectionné -->
                    <TextBlock Grid.Column="4" Style="{StaticResource Pd.Hint}" Margin="12" TextAlignment="Center" VerticalAlignment="Center"
                               Text="Sélectionnez un bouton, ou cliquez sur « Ajouter »."
                               Visibility="{Binding SelectedProfile.HasNoSelection, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                    <Grid Grid.Column="4" DataContext="{Binding SelectedProfile.SelectedButton}"
                          Visibility="{Binding DataContext.SelectedProfile.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Pd.Card}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="72" Height="72" Margin="0,0,14,0" VerticalAlignment="Center" StretchDirection="DownOnly">
                                    <ContentPresenter Content="{Binding Preview}" ContentTemplate="{StaticResource TilePreview}" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Libellé" Style="{StaticResource Pd.Label}" />
                                    <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Libellé du bouton" />
                                    <CheckBox Margin="0,6,0,0" Content="Afficher le libellé" IsChecked="{Binding ShowLabel}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" Margin="0,8,0,0" Padding="0">
                            <TabItem Header="Actions">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,8,8,0">
                                        <!-- Séquence d'actions -->
                                        <Border Style="{StaticResource Pd.Card}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE70E;" ToolTip="Monter" Command="{Binding MoveStepUpCommand}" AutomationProperties.Name="Monter l'étape" />
                                                        <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE70D;" ToolTip="Descendre" Command="{Binding MoveStepDownCommand}" AutomationProperties.Name="Descendre l'étape" />
                                                        <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE8C8;" ToolTip="Dupliquer l'étape" Command="{Binding DuplicateStepCommand}" AutomationProperties.Name="Dupliquer l'étape" />
                                                        <Button Style="{StaticResource Pd.SubtleButton}" Content="&#xE74D;" ToolTip="Supprimer l'étape" Command="{Binding DeleteStepCommand}" AutomationProperties.Name="Supprimer l'étape" />
                                                    </StackPanel>
                                                    <TextBlock Text="Actions" Style="{StaticResource Pd.Section}" Margin="0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,8"
                                                           Text="Les étapes s'exécutent dans l'ordre. Exemple : lancer OBS → attendre → choisir une scène → jouer un jingle."
                                                           Visibility="{Binding HasNoSteps, Converter={StaticResource BoolToVis}}" />
                                                <ListBox x:Name="StepsList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" MaxHeight="260"
                                                         ctl:DragReorder.MoveCommand="{Binding MoveStepCommand}" AutomationProperties.Name="Étapes"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="StepsList_KeyDown">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                                            <Grid AutomationProperties.Name="{Binding Description}">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="26" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Index}" Foreground="{DynamicResource Pd.TextTertiary}" VerticalAlignment="Center" FontSize="12" />
                                                                <TextBlock Grid.Column="1" Style="{StaticResource Pd.Glyph}" Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Left" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Style="{StaticResource Pd.Glyph}" Text="&#xE7BA;" FontSize="14" Margin="6,0,0,0"
                                                                           Foreground="{DynamicResource Pd.Warning}" ToolTip="Configuration incomplète"
                                                                           Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button x:Name="AddActionButton" Margin="0,8,0,0" HorizontalAlignment="Left" Click="AddActionButton_Click"
                                                        AutomationProperties.Name="Ajouter une action">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="Ajouter une action" />
                                                        <TextBlock Style="{StaticResource Pd.Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Étape sélectionnée -->
                                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0" DataContext="{Binding SelectedStep}"
                                                Visibility="{Binding DataContext.HasSelectedStep, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Style="{StaticResource Pd.Glyph}" Text="{Binding Glyph}" FontSize="16" Margin="0,0,8,0" />
                                                    <TextBlock Style="{StaticResource Pd.Section}" Margin="0">
                                                        <Run Text="{Binding Index, Mode=OneWay, StringFormat='Étape {0} — '}" /><Run Text="{Binding TypeName, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding TypeDescription}" Margin="0,0,0,14" />
                                                <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" />
                                                <Separator Margin="0,4,0,12" />
                                                <CheckBox Content="Étape active" IsChecked="{Binding Enabled}" />
                                                <TextBlock Text="En cas d'erreur" Style="{StaticResource Pd.Label}" Margin="0,12,0,4" />
                                                <ComboBox ItemsSource="{Binding ErrorPolicies}" SelectedItem="{Binding SelectedErrorPolicy}" DisplayMemberPath="Label"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="En cas d'erreur" />
                                                <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource Pd.WarningText}" Text="{Binding StringFormat='• {0}'}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Test -->
                                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" MinWidth="100" Content="{Binding TestButtonText}" Command="{Binding TestCommand}"
                                                            ToolTip="Exécuter la séquence maintenant (un second clic l'annule)" />
                                                    <TextBlock Text="Tester" Style="{StaticResource Pd.Section}" Margin="0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding TestTarget}" />
                                                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Pd.TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
                                                                </DataTrigger>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                                <Trigger Property="Text" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Apparence">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Border Style="{StaticResource Pd.Card}" Margin="0,8,8,12">
                                        <StackPanel>
                                        <TextBlock Text="Icône" Style="{StaticResource Pd.Label}" Margin="0,0,0,4" />
                                        <WrapPanel>
                                            <RadioButton Content="Aucune" IsChecked="{Binding IsIconNone}" Margin="0,0,14,4" MinWidth="0" />
                                            <RadioButton Content="Symbole" IsChecked="{Binding IsIconGlyph}" Margin="0,0,14,4" MinWidth="0" />
                                            <RadioButton Content="Emoji" IsChecked="{Binding IsIconEmoji}" Margin="0,0,14,4" MinWidth="0" />
                                            <RadioButton Content="Logo d'appli" IsChecked="{Binding IsIconBrand}" Margin="0,0,14,4" MinWidth="0" />
                                            <RadioButton Content="Image" IsChecked="{Binding IsIconImage}" Margin="0,0,14,4" MinWidth="0" />
                                            <RadioButton Content="Texte" IsChecked="{Binding IsIconText}" Margin="0,0,0,4" MinWidth="0" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,2,0,0" Text="{Binding CurrentIconText}" />

                                        <!-- Sélecteur : symboles Fluent, emoji, logos (recherche + catégories, liste virtualisée) -->
                                        <StackPanel Margin="0,8,0,0" DataContext="{Binding Picker}"
                                                    Visibility="{Binding DataContext.ShowPicker, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <ComboBox DockPanel.Dock="Right" Width="150" Margin="6,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                                                          AutomationProperties.Name="Catégorie d'icônes" />
                                                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Rechercher une icône"
                                                         ToolTip="{Binding Placeholder}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding Placeholder}" Margin="0,2,0,4" />
                                            <ListBox ItemsSource="{Binding Rows}" Height="250" AutomationProperties.Name="Icônes"
                                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:IconRow}">
                                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Pd.SubtleButton}" Width="44" Height="42" Margin="0,0,2,2"
                                                                            Foreground="{DynamicResource Pd.Text}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Text}" FontFamily="{Binding Font}" FontSize="22"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <Path Data="{Binding Geometry}" Fill="{DynamicResource Pd.Text}" Stretch="Uniform" Width="22" Height="22" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding CountText}" />
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsIconText, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Texte affiché à la place de l'icône" Style="{StaticResource Pd.Label}" />
                                            <TextBox Width="160" HorizontalAlignment="Left" MaxLength="6" FontSize="16" FontWeight="SemiBold"
                                                     Text="{Binding IconText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Texte de l'icône" />
                                            <TextBlock Style="{StaticResource Pd.Hint}" Text="1 à 4 caractères conseillés (ex. S1, S2 pour des scènes, REC, LIVE…). La taille s'adapte à la longueur." />
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsIconImage, Converter={StaticResource BoolToVis}}">
                                            <WrapPanel>
                                                <Button Content="Choisir une image…" Margin="0,0,6,6" Command="{Binding BrowseImageCommand}" />
                                                <Button Content="Icône d'un programme…" Margin="0,0,6,6" Command="{Binding BrowseProgramIconCommand}"
                                                        ToolTip="Utiliser l'icône officielle d'une application installée (fichier .exe ou raccourci)" />
                                                <Button Content="Icône du programme lancé" Margin="0,0,0,6" Command="{Binding UseLaunchedProgramIconCommand}"
                                                        ToolTip="{Binding LaunchedProgram}" />
                                            </WrapPanel>
                                            <TextBox Text="{Binding ImagePath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Image" />
                                            <TextBlock Style="{StaticResource Pd.Hint}" Text="L'image ou l'icône est copiée dans le dossier de ZogmaDeck (PNG, JPG, ICO…)." />
                                            <TextBlock Style="{StaticResource Pd.WarningAuto}" Text="{Binding ImageWarning}" />
                                        </StackPanel>

                                        <TextBlock Text="Couleur" Style="{StaticResource Pd.Label}" Margin="0,14,0,6" />
                                        <ItemsControl ItemsSource="{x:Static vm:ButtonEditViewModel.Palette}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Pd.Swatch}" Background="{Binding}" ToolTip="{Binding}"
                                                            AutomationProperties.Name="{Binding}"
                                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,8,0"
                                                    BorderBrush="{DynamicResource Pd.Border}" BorderThickness="1" />
                                            <TextBox Width="120" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Couleur hexadécimale" />
                                            <ctl:ColorPicker Margin="8,0,0,0" Color="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding ColorError}" />

                                        <TextBlock Text="Après exécution" Style="{StaticResource Pd.Label}" Margin="0,14,0,4" />
                                        <ComboBox ItemsSource="{Binding HideOptions}" SelectedItem="{Binding SelectedHide}" DisplayMemberPath="Label"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Après exécution" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= RÉGLAGES ================= -->
            <TabItem Header="Réglages">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Settings}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="760" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <TextBlock Text="Raccourci global" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,8"
                                           Text="Affiche ou masque le panneau depuis n'importe quelle application. Cliquez dans la zone puis appuyez sur la nouvelle combinaison : elle est vérifiée immédiatement." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Par défaut" ToolTip="Ctrl + Alt + Espace" Command="{Binding ResetHotkeyCommand}" />
                                    <ctl:KeyChordBox Chord="{Binding Hotkey}" AutomationProperties.Name="Raccourci global" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding HotkeyError}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Panneau" Style="{StaticResource Pd.Section}" />
                                <CheckBox Content="Toujours au premier plan" IsChecked="{Binding AlwaysOnTop}" />
                                <CheckBox Margin="0,8,0,0" Content="Masquer le panneau après une action (modifiable pour chaque bouton)" IsChecked="{Binding HideAfterAction}" />
                                <CheckBox Margin="0,8,0,0" Content="Masquer le panneau quand une autre fenêtre est activée" IsChecked="{Binding HideOnDeactivate}" />
                                <CheckBox Margin="0,8,0,0" Content="Utiliser l'accélération graphique (GPU) — au prochain démarrage" IsChecked="{Binding HardwareAcceleration}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="Désactivée par défaut : le rendu logiciel suffit pour ZogmaDeck et évite des fenêtres vides sur certaines configurations." />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,10,0,0"
                                           Text="Thème clair ou sombre, couleur de fond et couleur principale : onglet Apparence › Couleurs de l'éditeur." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Démarrage" Style="{StaticResource Pd.Section}" />
                                <CheckBox Content="Lancer ZogmaDeck à l'ouverture de session Windows (dans la zone de notification)" IsChecked="{Binding StartWithWindows}" />
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding StartupError}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Mises à jour" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding CurrentVersionText}" Margin="0,0,0,8" />
                                <CheckBox Content="Rechercher les mises à jour automatiquement (au plus deux fois par jour)" IsChecked="{Binding CheckForUpdates}" />
                                <TextBlock Style="{StaticResource Pd.Hint}"
                                           Text="Version Microsoft Store : le Store est interrogé. Autres versions : la dernière version publiée sur GitHub (github.com/tpodgro/ZOGMADECK). Aucune autre information n'est envoyée." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Rechercher maintenant" Command="{Binding CheckUpdatesNowCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding UpdateButtonText}" Command="{Binding InstallUpdateCommand}"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Pd.HintAuto}" Text="{Binding UpdateStatus}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Données" Style="{StaticResource Pd.Section}" />
                                <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Dossier des données" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding StorageMode}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Ouvrir le dossier des données" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="Ouvrir les journaux" Command="{Binding OpenLogsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Raccourcis du panneau" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0" LineHeight="22">
                                    <Run Text="Échap : masquer le panneau" /><LineBreak />
                                    <Run Text="1 à 9 : exécuter le bouton correspondant" /><LineBreak />
                                    <Run Text="Flèches puis Entrée ou Espace : choisir et exécuter un bouton" /><LineBreak />
                                    <Run Text="Ctrl+Tab / Ctrl+Maj+Tab : profil suivant / précédent — Ctrl+1 à 9 : profil n°" /><LineBreak />
                                    <Run Text="Ctrl+E : ouvrir l'éditeur — clic droit sur un bouton : le modifier" /><LineBreak />
                                    <Run Text="Recliquer sur un bouton en cours d'exécution l'annule." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= APPARENCE DU PANNEAU ================= -->
            <TabItem Header="Apparence">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Appearance}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="760" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}" Margin="0,0,0,12"
                                DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <TextBlock Text="Couleurs de l'éditeur" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10"
                                           Text="Fond, cartes et couleur principale des fenêtres de ZogmaDeck (éditeur, menus). Le panneau de boutons garde son apparence ci-dessous." />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,0,0,4" Text="Thème" />
                                <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" IsEnabled="{Binding CanChooseTheme}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="Thème" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="Avec une couleur de fond personnalisée, le thème clair ou sombre suit cette couleur."
                                           Visibility="{Binding UseCustomBackground, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,14,0,4" Text="Couleur principale (cases, curseurs, boutons d'action…)" />
                                <RadioButton Content="Couleur d'accentuation de Windows" IsChecked="{Binding UseWindowsAccent}" GroupName="Accent" />
                                <RadioButton Content="Couleur personnalisée" IsChecked="{Binding UseCustomAccent}" GroupName="Accent" Margin="0,4,0,0" />
                                <StackPanel Margin="28,6,0,0" Visibility="{Binding UseCustomAccent, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.AccentPalette}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Pd.Swatch}" Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                        Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBox Width="120" Text="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Couleur principale" />
                                        <ctl:ColorPicker Margin="8,0,0,0" Color="{Binding AccentText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,14,0,4" Text="Couleur de fond" />
                                <RadioButton Content="Fond du thème (clair ou sombre)" IsChecked="{Binding UseThemeBackground}" GroupName="EditorBackground" />
                                <RadioButton Content="Couleur personnalisée" IsChecked="{Binding UseCustomBackground}" GroupName="EditorBackground" Margin="0,4,0,0" />
                                <StackPanel Margin="28,6,0,0" Visibility="{Binding UseCustomBackground, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.BackgroundPalette}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Pd.Swatch}" Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                        BorderBrush="{DynamicResource Pd.BorderStrong}"
                                                        Command="{Binding DataContext.SetBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBox Width="120" Text="{Binding BackgroundText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Couleur de fond de l'éditeur" />
                                        <ctl:ColorPicker Margin="8,0,0,0" Color="{Binding BackgroundText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Pd.Hint}" Text="Le texte passe automatiquement en clair sur un fond foncé, et en foncé sur un fond clair." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButtonStyle}" Content="Afficher le panneau" Command="{Binding PreviewCommand}" Margin="0,0,8,0"
                                                ToolTip="Affiche le panneau à côté de l'éditeur : les réglages s'appliquent en direct." />
                                        <Button Content="Valeurs par défaut" Command="{Binding ResetCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="Fond du panneau" Style="{StaticResource Pd.Section}" VerticalAlignment="Center" Margin="0" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,4,0,10"
                                           Text="Par défaut : verre dépoli, un voile blanc à 30 % sur l'arrière-plan flouté. Mettez l'opacité à 0 et désactivez le flou pour un panneau entièrement transparent." />
                                <CheckBox Content="Flouter ce qui se trouve derrière le panneau (verre dépoli)" IsChecked="{Binding BlurBehind}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Pd.Label}" Text="{Binding OpacityText, StringFormat='Opacité du fond : {0}'}" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding BackgroundOpacity}" IsSnapToTickEnabled="True" TickFrequency="5"
                                        AutomationProperties.Name="Opacité du fond" />
                                <TextBlock Text="Couleur du fond" Style="{StaticResource Pd.Label}" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{x:Static vm:AppearanceViewModel.Palette}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Pd.Swatch}" Background="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                    BorderBrush="{DynamicResource Pd.BorderStrong}"
                                                    Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource Pd.Border}" BorderThickness="1" />
                                    <TextBox Width="120" Text="{Binding BackgroundColorText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Couleur du fond" />
                                    <ctl:ColorPicker Margin="8,0,0,0" Color="{Binding BackgroundColorText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding ColorError}" />

                                <TextBlock Text="Image de fond" Style="{StaticResource Pd.Label}" Margin="0,14,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Retirer" Margin="6,0,0,0" Command="{Binding ClearImageCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Choisir…" Margin="6,0,0,0" Command="{Binding BrowseImageCommand}" />
                                    <TextBox Text="{Binding BackgroundImage, Mode=OneWay, TargetNullValue='(aucune)'}" IsReadOnly="True" AutomationProperties.Name="Image de fond" />
                                </DockPanel>
                                <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Pd.Label}" Margin="0,8,0,4" Text="{Binding BackgroundImageOpacity, StringFormat='Opacité de l\'image : {0} %'}" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding BackgroundImageOpacity}" IsSnapToTickEnabled="True" TickFrequency="5"
                                            AutomationProperties.Name="Opacité de l'image" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Boutons" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Label}" Text="Style des boutons" />
                                <ComboBox Width="360" HorizontalAlignment="Left" Margin="0,0,0,12" ItemsSource="{Binding TileStyles}"
                                          SelectedItem="{Binding SelectedTileStyle}" DisplayMemberPath="Label" AutomationProperties.Name="Style des boutons" />
                                <TextBlock Style="{StaticResource Pd.Label}" Text="{Binding IconScale, StringFormat='Taille des icônes : {0} %'}" />
                                <Slider Minimum="40" Maximum="200" Value="{Binding IconScale}" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="Taille des icônes" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,10,0,4" Text="{Binding LabelScale, StringFormat='Taille des libellés : {0} %'}" />
                                <Slider Minimum="60" Maximum="180" Value="{Binding LabelScale}" IsSnapToTickEnabled="True" TickFrequency="5" AutomationProperties.Name="Taille des libellés" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,10,0,4" Text="{Binding TileSpacing, StringFormat='Espacement : {0} px'}" />
                                <Slider Minimum="0" Maximum="32" Value="{Binding TileSpacing}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Espacement" />
                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,10,0,4" Text="{Binding TileCornerRadius, StringFormat='Arrondi des boutons : {0} px'}" />
                                <Slider Minimum="0" Maximum="40" Value="{Binding TileCornerRadius}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Arrondi des boutons" />
                                <CheckBox Margin="0,10,0,0" Content="Afficher les numéros de raccourci (1 à 9)" IsChecked="{Binding ShowShortcutNumbers}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,10,0,0"
                                           Text="La taille des boutons et le nombre de colonnes se règlent par profil (onglet Boutons), ou directement sur le panneau : Ctrl + molette, clic droit sur le fond." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Taille et position" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,8"
                                           Text="Redimensionnez le panneau par son bord droit, son bord bas ou son coin : les boutons gardent leur taille et se répartissent dans la place disponible (une colonne, une rangée ou une grille)." />
                                <ComboBox Width="360" HorizontalAlignment="Left" Margin="0,0,0,12" ItemsSource="{Binding SizeModes}" SelectedItem="{Binding SelectedSizeMode}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="Taille du panneau" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,8"
                                           Text="Faites glisser le fond du panneau pour le déplacer : sa position est mémorisée et réutilisée sur l'écran actif." />
                                <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="Position du panneau" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Recentrer le panneau" Command="{Binding RecenterCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= OBS ================= -->
            <TabItem Header="OBS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Obs}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="760" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <TextBlock Text="Connexion à OBS Studio" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,12"
                                           Text="Dans OBS : Outils › Paramètres du serveur WebSocket › cochez « Activer le serveur WebSocket ». ZogmaDeck utilise obs-websocket 5 (inclus dans OBS 28 et plus récent). La connexion s'établit à la demande, sans interrogation en arrière-plan." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Adresse" Style="{StaticResource Pd.Label}" />
                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Adresse OBS" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource Pd.Label}" />
                                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Port OBS" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding PortError}" />

                                <TextBlock Text="Mot de passe" Style="{StaticResource Pd.Label}" Margin="0,12,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Effacer" Margin="6,0,0,0" Command="{Binding ClearPasswordCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Enregistrer" Margin="6,0,0,0" Click="SavePassword_Click" />
                                    <PasswordBox x:Name="ObsPassword" AutomationProperties.Name="Mot de passe OBS" KeyDown="ObsPassword_KeyDown" LostKeyboardFocus="ObsPassword_LostFocus" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding PasswordStatus}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="Le mot de passe est enregistré dès que vous quittez le champ (ou avec Entrée)." />

                                <TextBlock Style="{StaticResource Pd.Label}" Margin="0,12,0,4" Text="{Binding Timeout, StringFormat='Délai maximal de réponse : {0} s'}" />
                                <Slider Minimum="1" Maximum="60" Value="{Binding Timeout}" IsSnapToTickEnabled="True" TickFrequency="1" Width="300" HorizontalAlignment="Left"
                                        AutomationProperties.Name="Délai maximal de réponse" />
                                <CheckBox Margin="0,10,0,0" Content="Se connecter au démarrage de ZogmaDeck (une seule tentative)" IsChecked="{Binding ConnectOnStartup}" />

                                <Separator Margin="0,14,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Pd.ErrorAuto}" Text="{Binding LastError}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Tester la connexion" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                                    <Button Content="Se déconnecter" Command="{Binding DisconnectCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding TestResult}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Pd.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TestIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Utilisation" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0"
                                           Text="Ajoutez à un bouton l'action « OBS Studio » puis choisissez une commande : changer de scène, démarrer ou arrêter l'enregistrement ou le stream, couper le micro d'une source… Le bouton « Liste OBS » récupère les noms exacts des scènes et sources. Le mode « Requête personnalisée » permet d'envoyer n'importe quelle requête obs-websocket avec des données JSON." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= INTÉGRATIONS ================= -->
            <TabItem Header="Intégrations">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Integrations}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="760" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <TextBlock Text="TeamSpeak 3" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10"
                                           Text="ZogmaDeck pilote TeamSpeak 3 par son module ClientQuery (local, port 25639) : micro, son, absence, connexion, déconnexion, salons, pseudo. Dans TeamSpeak 3 : Outils › Options › Modules › activez « ClientQuery », puis « Paramètres » et copiez la clé API." />
                                <TextBlock Text="Clé API ClientQuery" Style="{StaticResource Pd.Label}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Effacer" Margin="6,0,0,0" Command="{Binding ClearTs3KeyCommand}" />
                                    <PasswordBox x:Name="Ts3ApiKeyBox" Tag="ts3ApiKey" AutomationProperties.Name="Clé API TeamSpeak 3"
                                                 KeyDown="SecretBox_KeyDown" LostKeyboardFocus="SecretBox_LostFocus" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding Ts3KeyStatus}" />
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" Content="Tester la connexion" Command="{Binding Ts3TestCommand}" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Ts3Result}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Pd.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ts3IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="TeamSpeak 5 / 6" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10" LineHeight="20">
                                    <Run Text="TeamSpeak 5/6 accepte des « Remote Apps » (Paramètres › Remote Apps, port 5899). Les commandes de ZogmaDeck y arrivent comme des boutons :" /><LineBreak />
                                    <Run Text="1. Cliquez sur « Autoriser dans TeamSpeak » et acceptez la demande dans TeamSpeak." /><LineBreak />
                                    <Run Text="2. Dans TeamSpeak › Paramètres › Raccourcis, ajoutez un raccourci pour l'action voulue (ex. couper le micro), puis appuyez sur le bouton correspondant de ZogmaDeck pour l'associer." /><LineBreak />
                                    <Run Text="La connexion à un serveur passe par un lien ts3server:// et ne demande aucune association." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding Ts6Status}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Autoriser dans TeamSpeak" Command="{Binding Ts6PairCommand}" Margin="0,0,8,0" />
                                    <Button Content="Oublier l'autorisation" Command="{Binding Ts6ForgetCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Ts6Result}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Pd.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ts6IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Discord" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10" LineHeight="20">
                                    <Run Text="Discord réserve son contrôle local (RPC) aux applications enregistrées. Configuration unique et gratuite :" /><LineBreak />
                                    <Run Text="1. Sur le portail développeur de Discord, créez une application (nom libre, ex. « ZogmaDeck »)." /><LineBreak />
                                    <Run Text="2. Onglet OAuth2 : copiez le « Client ID » et le « Client Secret » ci-dessous, et ajoutez la redirection http://localhost." /><LineBreak />
                                    <Run Text="3. Onglet App Testers : ajoutez votre propre compte Discord si Discord le demande." /><LineBreak />
                                    <Run Text="4. Lancez l'application Discord, cliquez sur « Autoriser dans Discord » et acceptez la demande." />
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,0,0,10">
                                    <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://discord.com/developers/applications">Ouvrir le portail développeur de Discord</Hyperlink>
                                </TextBlock>
                                <TextBlock Text="Client ID (identifiant de l'application)" Style="{StaticResource Pd.Label}" />
                                <TextBox Text="{Binding DiscordClientId, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Identifiant de l'application Discord" />
                                <TextBlock Text="Client Secret" Style="{StaticResource Pd.Label}" Margin="0,10,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Effacer" Margin="6,0,0,0" Command="{Binding ClearDiscordSecretCommand}" />
                                    <PasswordBox x:Name="DiscordSecretBox" Tag="discordClientSecret" AutomationProperties.Name="Secret de l'application Discord"
                                                 KeyDown="SecretBox_KeyDown" LostKeyboardFocus="SecretBox_LostFocus" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding DiscordSecretStatus}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Text="{Binding DiscordStatus}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Autoriser dans Discord" Command="{Binding DiscordAuthorizeCommand}" Margin="0,0,8,0" />
                                    <Button Content="Oublier l'autorisation" Command="{Binding DiscordForgetCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding DiscordResult}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Pd.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscordIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,8,0,0"
                                           Text="Le secret et l'autorisation sont chiffrés sur ce poste et jamais exportés. Seules l'autorisation et son renouvellement contactent discord.com ; les commandes restent locales. ZogmaDeck garde la connexion à Discord ouverte : Discord annule les réglages vocaux d'une application qui se déconnecte." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= SAUVEGARDE ================= -->
            <TabItem Header="Import / export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Backup}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="820" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <TextBlock Text="Exporter" Style="{StaticResource Pd.Section}" />
                                <RadioButton Content="Tous les profils" IsChecked="{Binding ExportAll}" />
                                <RadioButton Margin="0,6,0,0" IsChecked="{Binding ExportActive}">
                                    <TextBlock Text="{Binding ActiveProfileName, StringFormat='Uniquement le profil affiché dans le panneau ({0})'}" />
                                </RadioButton>
                                <CheckBox Margin="0,10,0,0" Content="Inclure les réglages (raccourci, thème, adresse OBS)" IsChecked="{Binding IncludeSettings}" />
                                <TextBlock Style="{StaticResource Pd.Hint}"
                                           Text="Le fichier .zogmadeck contient les images et les sons utilisés. Le mot de passe OBS n'est jamais exporté." />
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" Content="Exporter…" Command="{Binding ExportCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Importer" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10"
                                           Text="Importez un fichier .zogmadeck (ou un config.json). Le contenu est vérifié et affiché avant toute modification ; aucune action n'est exécutée. Une sauvegarde est créée avant l'import." />
                                <Button HorizontalAlignment="Left" Content="Choisir un fichier…" Command="{Binding ImportCommand}" />

                                <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource Pd.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Pd.Border}" BorderThickness="1"
                                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding PreviewWarnings}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource Pd.WarningText}" Text="{Binding StringFormat='• {0}'}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                            <TextBlock Text="Ressources introuvables sur ce poste (les boutons concernés afficheront une erreur) :"
                                                       Foreground="{DynamicResource Pd.Warning}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding PreviewMissing}" Focusable="False" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,2,0,0" Text="{Binding StringFormat='• {0}'}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <RadioButton Margin="0,12,0,0" Content="Ajouter ces profils à ceux existants" IsChecked="{Binding ImportMerge}" />
                                        <RadioButton Margin="0,6,0,0" Content="Remplacer tous mes profils" IsChecked="{Binding ImportReplace}" />
                                        <CheckBox Margin="0,10,0,0" Content="Importer aussi les réglages (raccourci, thème, adresse OBS)"
                                                  IsChecked="{Binding ImportSettings}" IsEnabled="{Binding PreviewHasSettings}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource AccentButtonStyle}" Content="Importer" Command="{Binding ConfirmImportCommand}" Margin="0,0,8,0" />
                                            <Button Content="Annuler" Command="{Binding CancelImportCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="4,12,4,0" TextWrapping="Wrap" Text="{Binding Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Pd.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Pd.Warning}" />
                                        </DataTrigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource Pd.Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ouvrir le dossier" Command="{Binding OpenBackupsCommand}" />
                                    <TextBlock Text="Sauvegardes automatiques" Style="{StaticResource Pd.Section}" VerticalAlignment="Center" Margin="0" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,4,0,8"
                                           Text="Une copie par jour et une copie avant chaque import, suppression de profil ou restauration (10 dernières conservées). La version précédente est aussi gardée dans config.json.bak." />
                                <ItemsControl ItemsSource="{Binding Snapshots}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="Restaurer"
                                                        Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= DIAGNOSTIC ================= -->
            <TabItem Header="Diagnostic">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Diagnostics}">
                    <StackPanel Margin="4,12,4,12" MaxWidth="820" HorizontalAlignment="Left" MinWidth="560">
                        <Border Style="{StaticResource Pd.Card}">
                            <StackPanel>
                                <TextBlock Text="Performances mesurées" Style="{StaticResource Pd.Section}" />
                                <TextBlock Style="{StaticResource Pd.Hint}" Margin="0,0,0,10"
                                           Text="Valeurs lues sur le processus ZogmaDeck au moment de l'actualisation (aucune mesure en continu)." />
                                <ItemsControl ItemsSource="{Binding Metrics}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Pd.TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Actualiser" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                                    <Button Content="Copier" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                                    <Button Content="Ouvrir les journaux" Command="{Binding OpenLogsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
