<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ZogmaDeck.Controls">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <FontFamily x:Key="Pd.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Pd.MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Texte -->
    <Style x:Key="Pd.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Pd.IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>
    <Style x:Key="Pd.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
    </Style>
    <Style x:Key="Pd.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Pd.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Pd.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Pd.ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Pd.Hint}">
        <Setter Property="Foreground" Value="{DynamicResource Pd.Error}" />
    </Style>
    <Style x:Key="Pd.WarningText" TargetType="TextBlock" BasedOn="{StaticResource Pd.Hint}">
        <Setter Property="Foreground" Value="{DynamicResource Pd.Warning}" />
    </Style>

    <!-- Variantes masquées automatiquement quand le texte est vide -->
    <Style x:Key="Pd.HintAuto" TargetType="TextBlock" BasedOn="{StaticResource Pd.Hint}">
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Pd.ErrorAuto" TargetType="TextBlock" BasedOn="{StaticResource Pd.ErrorText}">
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Pd.WarningAuto" TargetType="TextBlock" BasedOn="{StaticResource Pd.WarningText}">
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Anneau de focus : WPF ne l'affiche que lors d'une navigation au clavier (pas au clic souris) -->
    <Style x:Key="Pd.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Pd.FocusRing}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Puce : fond semi-opaque des éléments du panneau -->
    <Style x:Key="Pd.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pd.ChipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pd.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Carte -->
    <Style x:Key="Pd.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pd.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pd.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Bouton discret à icône (barres d'outils) -->
    <Style x:Key="Pd.SubtleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Pd.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Pd.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Pd.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Pd.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pastille de profil -->
    <Style x:Key="Pd.Pill" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Pd.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Pd.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Pd.PillActive" TargetType="Button" BasedOn="{StaticResource Pd.Pill}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tuile de bouton du deck -->
    <Style x:Key="Pd.TileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="bg" CornerRadius="{Binding CornerRadius, FallbackValue=8}" Background="{TemplateBinding Background}"
                                BorderBrush="{Binding TileBorder, FallbackValue=#26000000}" BorderThickness="1" />
                        <Border CornerRadius="{Binding CornerRadius, FallbackValue=8}" Background="{Binding Sheen}" IsHitTestVisible="False" />
                        <Border x:Name="overlay" CornerRadius="{Binding CornerRadius, FallbackValue=8}" Background="White" Opacity="0" />
                        <ContentPresenter Margin="6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="overlay" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="overlay" Property="Background" Value="Black" />
                            <Setter TargetName="overlay" Property="Opacity" Value="0.16" />
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tuile « Ajouter » -->
    <Style x:Key="Pd.AddTileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding TextBrush, FallbackValue=Gray}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="dash" RadiusX="{Binding Radius, FallbackValue=8}" RadiusY="{Binding Radius, FallbackValue=8}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                   Stroke="{Binding Stroke}" Fill="{Binding Fill}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dash" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pastille de couleur (éditeur) -->
    <Style x:Key="Pd.Swatch" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Pd.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{DynamicResource Pd.BorderStrong}" />
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Pd.BorderStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
