<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Jetons ZogmaDeck, thème sombre (inspirés des couleurs Windows 11) -->
    <SolidColorBrush x:Key="Pd.WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="Pd.PanelBackground" Color="#272727" />
    <SolidColorBrush x:Key="Pd.Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Pd.SurfaceAlt" Color="#262626" />
    <SolidColorBrush x:Key="Pd.Border" Color="#3B3B3B" />
    <SolidColorBrush x:Key="Pd.BorderStrong" Color="#505050" />
    <SolidColorBrush x:Key="Pd.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Pd.TextSecondary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Pd.TextTertiary" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Pd.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Pd.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Pd.Selected" Color="#2F3B4A" />
    <SolidColorBrush x:Key="Pd.SelectedBorder" Color="#4F7BB3" />
    <SolidColorBrush x:Key="Pd.FocusRing" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Pd.Error" Color="#FF99A4" />
    <SolidColorBrush x:Key="Pd.ErrorBackground" Color="#442726" />
    <SolidColorBrush x:Key="Pd.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Pd.Warning" Color="#FCE100" />
    <SolidColorBrush x:Key="Pd.WarningBackground" Color="#433519" />
    <SolidColorBrush x:Key="Pd.AddTile" Color="#E6262626" />
    <SolidColorBrush x:Key="Pd.ChipBackground" Color="#E6222222" />
    <SolidColorBrush x:Key="Pd.ChipBorder" Color="#24FFFFFF" />
</ResourceDictionary>
